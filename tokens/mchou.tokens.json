  "shadow": {
    "lip-gold": {
      "$type": "shadow",
      "$value": {
        "color": "#C98A12",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "+ inset 0 2px 0 #FFFFFF99"
    },
    "lip-plum": {
      "$type": "shadow",
      "$value": {
        "color": "#24062A",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "0px",
        "spread": "0px"
      }
    },
    "float": {
      "$type": "shadow",
      "$value": {
        "color": "#000000CC",
        "offsetX": "0px",
        "offsetY": "20px",
        "blur": "36px",
        "spread": "-14px"
      }
    },
    "sticker": {
      "$type": "shadow",
      "$description": "2px banana outline + 4px caramel-lip drop",
      "$value": [
        {
          "color": "#FFD84D",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "2px"
        },
        {
          "color": "#C98A12",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "2px"
        }
      ]
    }
  },
  "motion": {
    "duration": {
      "press": {
        "$type": "duration",
        "$value": "90ms"
      },
      "fast": {
        "$type": "duration",
        "$value": "180ms"
      },
      "base": {
        "$type": "duration",
        "$value": "280ms"
      },
      "sheet": {
        "$type": "duration",
        "$value": "360ms"
      },
      "release": {
        "$type": "duration",
        "$value": "420ms"
      },
      "countup": {
        "$type": "duration",
        "$value": "600ms"
      },
      "fly": {
        "$type": "duration",
        "$value": "720ms"
      },
      "signature-crepe": {
        "$type": "duration",
        "$value": "3500ms"
      },
      "signature-scooter": {
        "$type": "duration",
        "$value": "2600ms"
      }
    },
    "easing": {
      "out": {
        "$type": "cubicBezier",
        "$value": [
          0.22,
          1,
          0.36,
          1
        ]
      },
      "in": {
        "$type": "cubicBezier",
        "$value": [
          0.45,
          0.05,
          0.8,
          0.35
        ]
      },
      "spring": {
        "$type": "cubicBezier",
        "$value": [
          0.34,
          1.56,
          0.64,
          1
        ],
        "$description": "CSS stand-in for spring bouncy"
      },
      "sheet": {
        "$type": "cubicBezier",
        "$value": [
          0.32,
          0.72,
          0,
          1
        ]
      }
    },
    "spring": {
      "bouncy": {
        "$type": "number",
        "$value": 380,
        "$description": "stiffness 380, damping 18, mass 1 (buttons, badges)"
      },
      "smooth": {
        "$type": "number",
        "$value": 300,
        "$description": "stiffness 300, damping 30, mass 1 (shared element, pages)"
      }
    }
  },
  "feedback": {
    "$description": "Sounds on at first launch at about -18 dBFS, silent when the phone is muted. Haptics follow the platform's light / medium / success presets.",
    "sound": {
      "ding": {
        "$type": "string",
        "$value": "add to cart"
      },
      "pop": {
        "$type": "string",
        "$value": "badge, toggle"
      },
      "sparkle": {
        "$type": "string",
        "$value": "reward, Miams"
      },
      "whoosh": {
        "$type": "string",
        "$value": "scooter departure"
      }
    },
    "haptic": {
      "light": {
        "$type": "string",
        "$value": "add, toggle, chip"
      },
      "medium": {
        "$type": "string",
        "$value": "main CTA"
      },
      "success": {
        "$type": "string",
        "$value": "order confirmed, reward unlocked"
      }
    }
  }
