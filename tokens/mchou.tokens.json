  "font": {
    "script": {
      "$type": "fontFamily",
      "$value": [
        "Pacifico",
        "cursive"
      ]
    },
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Fredoka",
        "Baloo Bhaijaan 2",
        "system-ui",
        "sans-serif"
      ]
