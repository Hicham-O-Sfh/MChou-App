  "gradient": {
    "hero": {
      "$type": "gradient",
      "$description": "135deg",
      "$value": [
        {
          "color": "#4B2615",
          "position": 0
        },
        {
          "color": "#6B2D8B",
          "position": 1
        }
      ]
    },
    "cta": {
      "$type": "gradient",
      "$description": "180deg, top to bottom",
      "$value": [
        {
          "color": "#FFD36B",
          "position": 0
        },
        {
          "color": "#F7B538",
          "position": 1
        }
      ]
    },
    "gold-card": {
      "$type": "gradient",
      "$description": "160deg",
      "$value": [
        {
          "color": "#FFE08A",
          "position": 0
        },
        {
          "color": "#F7B538",
          "position": 1
        }
      ]
    }
