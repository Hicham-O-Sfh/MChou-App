    "body": {
      "$type": "fontFamily",
      "$value": [
        "Nunito",
        "Baloo Bhaijaan 2",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "typography": {
    "script": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.script}",
        "fontWeight": 400,
        "fontSize": "26px",
        "lineHeight": "40px"
      }
    },
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 700,
        "fontSize": "32px",
        "lineHeight": "36px"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 700,
        "fontSize": "26px",
        "lineHeight": "30px"
      }
    },
    "h2": {
      "$type": "typography",
